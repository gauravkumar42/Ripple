# Copy this file to .env for local development.
# On Vercel, set these as Environment Variables in the project settings instead.

PORT=8080

# MySQL connection (works with PlanetScale, Railway, Aiven, Clever Cloud, or local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ripple
# Some hosted MySQL providers require SSL - set to "true" if yours does
DB_SSL=false

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
